{
  "nix.enableLanguageServer": true,
  "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": ["nixfmt"]
      }
    }
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "rust-analyzer.cargo.features": ["diagnostics"],
  "explorer.excludeGitIgnore": true
}
