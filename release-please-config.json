{
  "packages": {
    ".": {
      "release-type": "rust",
      "draft": true,
      "force-tag-creation": true,
      "include-v-in-tag": true,
      "extra-files": [
        {
          "type": "json",
          "path": "assets/manifest.json",
          "jsonpath": "$.Version"
        }
      ],
      "include-component-in-tag": false
    }
  },
  "plugins": ["cargo-workspace"]
}
